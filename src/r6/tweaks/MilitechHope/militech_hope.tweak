// =====================================================================
//  Militech "Hope" (Надежда) Sandevistan — TweakXL definitions
//  Game: Cyberpunk 2077 2.5   Requires: TweakXL, Codeware (texts)
//  Generated from a per-tier table; keep the three tiers in sync.
//
//  Level    | Slow | Time  | Crit% | Headshot | Mitig. | Armor | On kill
//  Tier 5   | 95 % | 5.0 s |  +5   |  x1.15   |  +10   |  +50  | 20% stamina
//  Tier 5+  | 97 % | 7.5 s |  +7   |  x1.20   |  +15   |  +70  | 20% stamina, 5% HP
//  Tier 5++ | 99 % | 10  s |  +10  |  x1.25   |  +20   |  +90  | 25% stamina, 8% HP
//  All tiers: +10 % crit damage, +12 stamina, 10 s full recharge, humanity 50.
//  Tier 5++ only: bullets keep their real speed during Sandevistan (redscript).
//  Overheat (redscript, heat in degrees C): 40 C idle, 120 C = shutdown + 12 s lockout.
//    Each activation heats 22 C (30 C on Tier 5++), half as much from a full charge;
//    a fully recharged implant cools back to 40 C.
//  Tier 5++ has two upgrade slots (AttachmentSlots.SandevistanSlot1/2) for six
//  Militech upgrade modules (logic in redscript), sold by the broker or given by console.
//  Both installed modules work at the same time.
//  Headshot / mitigation / armor apply only while the Sandevistan is active.
// =====================================================================

// ---------------------------------------------------------------------
//  Inventory icon (texture is packed into archive/pc/mod/MilitechHope.archive)
// ---------------------------------------------------------------------
UIIcon.militech_hope_sandevistan : UIIcon
{
	atlasResourcePath = "militech_hope\\icons\\militech_hope_sandevistan.inkatlas";
	atlasPartName = "custom_icon";
}

// ---------------------------------------------------------------------
//  Overheat lockout: blocks Sandevistan activation for 12 seconds
// ---------------------------------------------------------------------
MilitechHope.SandevistanOverheat : BaseStatusEffect.PlayerCyberwareCooldown
{
	gameplayTags += [ "MilitechHopeOverheat" ];
	duration =
	{
		statModifiers =
		[
			{
				statType = "BaseStats.MaxDuration";
				modifierType = "Additive";
				value = 12f;
			} : ConstantStatModifier
		];
	} : StatModifierGroup;
	packages =
	[
		{
			stats =
			[
				{
					statType = "BaseStats.HasSandevistan";
					modifierType = "Multiplier";
					value = 0f;
				} : ConstantStatModifier
			];
		} : GameplayLogicPackage
	];
}

// ---------------------------------------------------------------------
//  Tier 5 (base)
// ---------------------------------------------------------------------
Items.MilitechHopeSandevistan : Items.SandevistanBase
{
	displayName = "LocKey#MilitechHope-Name";
	localizedDescription = "LocKey#MilitechHope-Lore";
	upgradeCostMult = 2.5f;
	iconPath = "militech_hope_sandevistan";
	tags += [ "MilitechHope" ];
	objectActions +=
	[
		"CyberwareAction.UseCooldownedSandevistan", "CyberwareAction.UseCooldownedCorruptedSandevistan"
	];
	variants = [ "Variants.Humanity50Cost" ];
	usesVariants = true;
	OnLooted = [];
	quality = "Quality.Legendary";
	statModifiers =
	[
		{
			statType = "BaseStats.IsItemIconic";
			modifierType = "Additive";
			value = 1f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.HasSandevistan";
			modifierType = "Additive";
			value = 1f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.TimeDilationSandevistanDuration";
			modifierType = "Additive";
			value = 5.0f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.TimeDilationSandevistanTimeScale";
			modifierType = "Additive";
			value = 0.05f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.TimeDilationSandevistanRechargeDuration";
			modifierType = "Additive";
			value = 10.0f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.TimeDilationSandevistanCooldownBase";
			modifierType = "Additive";
			value = 1f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.SandevistanKillRechargeValue";
			modifierType = "Additive";
			value = 10f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.TimeDilationSandevistanEnterCost";
			modifierType = "Additive";
			value = -10f;
		} : ConstantStatModifier,
		{
			statType = "BaseStats.AttunementHelper";
			modifierType = "Additive";
			refStat = "BaseStats.Reflexes";
			refObject = "Player";
			opSymbol = "*";
			value = 0.1f;
		} : CombinedStatModifier
	];
	OnEquip =
	[
		{
			UIData =
			{
				localizedDescription = "LocKey#MilitechHope-Core-T5";
			};
		} : GameplayLogicPackage,
		{
			stats =
			[
				{
					statType = "BaseStats.CritDamage";
					modifierType = "Additive";
					value = 10f;
				} : ConstantStatModifier,
				{
					statType = "BaseStats.CritChance";
					modifierType = "Additive";
					value = 5f;
				} : ConstantStatModifier,
				{
					statType = "BaseStats.Stamina";
					modifierType = "Additive";
					value = 12f;
				} : ConstantStatModifier
			];
			UIData =
			{
				localizedDescription = "LocKey#MilitechHope-Passive-T5";
			};
		} : GameplayLogicPackage,
		{
			effectors =
			[
				{
					prereqRecord =
					{
						string stateName = "Sandevistan";
						bool isInState = true;
					} : Prereqs.TimeDilationPSMPrereq;
					statGroup =
					{
						statModifiers =
						[
							{
								statType = "BaseStats.HeadshotDamageMultiplier";
								modifierType = "Multiplier";
								value = 1.15f;
							} : ConstantStatModifier,
							{
								statType = "BaseStats.MitigationChance";
								modifierType = "Additive";
								value = 10f;
							} : ConstantStatModifier,
							{
								statType = "BaseStats.Armor";
								modifierType = "Additive";
								value = 50f;
							} : ConstantStatModifier
						];
					};
				} : ApplyStatGroupEffector
			];
			UIData =
			{
				localizedDescription = "LocKey#MilitechHope-Active-T5";
			};
		} : GameplayLogicPackage,
		{
			effectors =
			[
				{
					prereqRecord =
					{
						string stateName = "Sandevistan";
						bool isInState = true;
					} : Prereqs.TimeDilationPSMPrereq;
					effectorToApply =
					{
						statPoolUpdates =
						[
							{
								statPoolType = "BaseStatPools.Stamina";
								statPoolValue = 20f;
							} : StatPoolUpdate
						];
					} : Items.RestoreStatPoolOnKillEffector;
				} : Perks.ApplyEffectorOnPlayer
			];
			UIData =
			{
				localizedDescription = "LocKey#MilitechHope-Kill-T5";
			};
		} : GameplayLogicPackage,
		{
			UIData =
			{
				localizedDescription = "LocKey#MilitechHope-Overheat-T5";
			};
		} : GameplayLogicPackage
	];
	nextUpgradeItem = "Items.MilitechHopeSandevistanPlus";
}

