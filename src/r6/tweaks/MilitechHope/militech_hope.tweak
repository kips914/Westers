// ---------------------------------------------------------------------
MilitechHope.SandevistanOverheatShort : MilitechHope.SandevistanOverheat
{
	duration =
	{
		statModifiers =
		[
			{
				statType = "BaseStats.MaxDuration";
				modifierType = "Additive";
				value = 8f;
			} : ConstantStatModifier
		];
	} : StatModifierGroup;
}

